#!/usr/bin/env bash
# factory-integration: a spec's integration branch and its dedicated worktree, and the
# mechanical merge of a finished ticket into it. Never switches the user's checkout and
# never touches the default branch.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  factory-integration ensure --spec S --branch B
      Fetch origin. If origin has no B, create it from the local B, or else from origin's default
      branch, and push it (hooks run). Make sure the integration worktree
      <project>/.claude/worktrees/spec-S exists on B, and record both with factory-state.
      Prints {spec, branch, worktree, created}.
  factory-integration merge --ticket N --branch TICKET_BRANCH [--worktree PATH] [--title TEXT]
      In the ticket's spec integration worktree (from factory-state): fast-forward to origin,
      merge TICKET_BRANCH with --no-ff, push through the hooks, then remove the ticket's
      worktree PATH (default: the one the ticket was assigned) and delete TICKET_BRANCH, locally
      and on origin, and record the merge with factory-state. Claude Code locks an agent's
      worktree ("claude agent agent-<id> (pid N start S)"): the lock is read, and when it names
      an agent the ledger shows finished, or a process that no longer exists (or whose pid now
      belongs to another process), the worktree is unlocked first. A lock of a running agent, or
      one that is not Claude Code's, is never broken: worktree and branch are left, and the result
      says so. worktree_removed (null: none to remove) and branch_deleted (local and remote both
      gone) are always what actually happened; worktree_lock is {state: none|finished|gone|running|
      unknown, reason}; cleanup_note says why anything was left.
      Then, with gh: after the spec's first merge, open one draft pull request from the
      integration branch to the default branch (unless one is open), naming the spec and the
      tickets merged so far, ending with the project's attribution.pr from .claude/settings*.json;
      each later merge adds its ticket and its Closes line to that body and changes nothing else.
      The pull request stays a draft. Prints {result, ..., pull_request: {number, url, created}};
      pull_request is null, with pull_request_error, when gh failed (the merge still stands).
      Merges into one integration branch take turns: this takes a lock for the branch under
      .factory/locks/ (first come, first served; a lock whose holder no longer exists is taken
      over, said on stderr) and releases it on every exit path. Merges into different branches
      never wait for each other. A merge that waited adds waited_seconds to its result.
      Every merge, merged or not, appends a `merge` ledger event with its result and its duration
      (queueing included), so merge time is a KPI. The manager runs this command itself, in the
      background, and is woken when it ends: no agent is started to wait for it.
      Exit 0: merged (even when clean-up was left). Exit 3: conflict (merge aborted, nothing pushed,
      worktree and branch kept; files listed). Exit 4: the integration branch has diverged from
      origin or the push failed (local merge undone; output included).
  factory-integration leftovers [--ticket N] [--json]
      Merged tickets whose worktree or branch (local or on origin) is still there, with the lock
      state of the worktree. Prints a table, or "No leftover worktrees or branches."; --json prints
      [{ticket, spec, branch, worktree, worktree_exists, branch_local, branch_remote, lock, lock_reason}].
  factory-integration cleanup [--ticket N]
      Retry the clean-up of every leftover (or of ticket N): the same rules as merge. Run it when an
      agent finishes. Prints [{ticket, spec, branch, worktree, worktree_removed, branch_deleted,
      remote_branch_deleted, worktree_lock, cleanup_note}].
USAGE
}

root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
# shellcheck disable=SC1091 # lib/common.sh, checked on its own
. "$root/lib/common.sh"
state_cmd="$root/bin/factory-state"

die() { echo "factory-integration: $*" >&2; exit 2; }
cmd=${1:-}
case "$cmd" in -h | --help) usage; exit 0 ;; ensure | merge | leftovers | cleanup) shift ;; *) usage >&2; exit 2 ;; esac
spec="" branch="" ticket="" worktree="" title="" json=0
while [ $# -gt 0 ]; do
  case "$1" in
    --spec) spec=${2:?}; shift ;;
    --branch) branch=${2:?}; shift ;;
    --ticket) ticket=${2:?}; shift ;;
    --worktree) worktree=${2:?}; shift ;;
    --title) title=${2:?}; shift ;;
    --json) json=1 ;;
    -h | --help) usage; exit 0 ;;
    *) die "unknown argument $1" ;;
  esac
  shift
done

project=$(factory_project)
export CLAUDE_PROJECT_DIR="$project"
g() { git -C "$project" "$@"; }

default_branch() {
  local d
  d=$(g symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)
  d=${d#origin/}
  if [ -z "$d" ]; then
    d=$( (cd "$project" && gh repo view --json defaultBranchRef --jq .defaultBranchRef.name) 2>/dev/null || true)
  fi
  printf '%s\n' "${d:-main}"
}

# pr_attribution: the project's pull request attribution (Claude Code's attribution.pr, from
# .claude/settings.local.json, else .claude/settings.json); empty when it has none.
pr_attribution() {
  local f a
  for f in "$project/.claude/settings.local.json" "$project/.claude/settings.json"; do
    [ -f "$f" ] || continue
    if a=$(jq -re '.attribution.pr | strings' "$f" 2>/dev/null); then printf '%s' "$a"; return; fi
  done
}

issue_title() { (cd "$project" && gh issue view "$1" --json title) | jq -r '.title // empty'; }

# draft_pr SPEC INTEGRATION_BRANCH DEFAULT_BRANCH TICKET TITLE: after a merge, opens the spec's
# draft pull request from its integration branch, unless one is open; an open one gets each merged
# ticket it lacks added to its list and its Closes lines, and nothing else in its body changes.
# Never marks it ready. Prints {number, url, created}; returns non-zero when gh fails.
draft_pr() {
  local spec=$1 ib=$2 def=$3 ticket=$4 title=$5 open merged body missing lines="" closes="" n t url
  merged=$("$state_cmd" show | jq -c --argjson s "$spec" \
    '[.merged[] | select(.spec == $s)] | sort_by(.merged_at, .ticket) | map(.ticket)') || return 1
  open=$(cd "$project" && gh pr list --head "$ib" --base "$def" --state open --json number,url,body --limit 1) || return 1
  body=$(jq -r '.[0].body // ""' <<<"$open") || return 1
  missing=$(jq -r --arg body "$body" '($body | split("\n")) as $l
    | .[] | select(. as $t | $l | any(test("^- #\($t)( |\r?$)")) | not)' <<<"$merged") || return 1
  for n in $missing; do
    if [ "$n" = "$ticket" ] && [ -n "$title" ]; then t=$title; else t=$(issue_title "$n" || true); fi
    lines+="- #$n${t:+ $t}"$'\n'
    jq -e --arg body "$body" --arg n "$n" '$body | split("\n") | any(test("^Closes #\($n)\r?$"))' >/dev/null <<<null \
      || closes+="Closes #$n"$'\n'
  done
  lines=${lines%$'\n'} closes=${closes%$'\n'}
  if [ "$(jq length <<<"$open")" = 0 ]; then
    local spec_title attribution
    spec_title=$(issue_title "$spec" || true)
    spec_title=$(sed -E 's/^[Ss]pec:[[:space:]]*//' <<<"$spec_title")
    attribution=$(pr_attribution)
    body="Spec #$spec${spec_title:+: $spec_title}

The factory opened this draft pull request when the spec's first ticket merged into \`$ib\`, so that CI runs on the integration branch. It stays a draft: marking it ready or merging it is the user's step.

Tickets merged so far:

$lines

$closes${attribution:+

$attribution}"
    url=$(cd "$project" && gh pr create --draft --base "$def" --head "$ib" \
      --title "Spec #$spec${spec_title:+: $spec_title}" --body-file - <<<"$body") || return 1
    url=$(tail -n 1 <<<"$url")
    n=${url##*/}
    [[ "$n" =~ ^[0-9]+$ ]] || { echo "gh pr create printed no pull request URL: $url" >&2; return 1; }
    jq -n --argjson n "$n" --arg url "$url" '{number: $n, url: $url, created: true}'
    return
  fi
  n=$(jq -r '.[0].number' <<<"$open") url=$(jq -r '.[0].url' <<<"$open")
  if [ -n "$missing" ]; then
    body=$(jq -rn --arg body "$body" --arg lines "$lines" --arg closes "$closes" '
      def after_last($re; $new):
        if $new == [] then . else
          ([to_entries[] | select(.value | test($re)) | .key] | last) as $i
          | if $i == null then . + [""] + $new else .[:$i + 1] + $new + .[$i + 1:] end
        end;
      def nonempty: split("\n") | map(select(length > 0));
      $body | split("\n")
      | after_last("^- #[0-9]+( |\r?$)"; $lines | nonempty)
      | after_last("^Closes #[0-9]+\r?$"; $closes | nonempty)
      | join("\n")') || return 1
    (cd "$project" && gh pr edit "$n" --body-file - <<<"$body") >/dev/null || return 1
  fi
  jq -n --argjson n "$n" --arg url "$url" '{number: $n, url: $url, created: false}'
}

# worktree_lock_reason PATH: the lock reason of a registered worktree (possibly empty); fails when
# the worktree is not locked.
worktree_lock_reason() {
  g worktree list --porcelain | awk -v p="$(readlink -f "$1")" '
    $1 == "worktree" { cur = substr($0, 10); next }
    cur == p && $1 == "locked" { sub(/^locked ?/, ""); print; found = 1 }
    END { exit !found }'
}

pid_alive() { kill -0 "$1" 2>/dev/null || [ -d "/proc/$1" ]; }

# classify_lock WORKTREE: sets lock_state and lock_reason.
#   none      not locked
#   finished  Claude Code's lock ("claude agent agent-<id> (pid N start S)") of an agent the ledger
#             shows stopped; the pid is Claude Code's own process and outlives the agent
#   gone      Claude Code's lock of an agent that never reported stopping, whose process no longer
#             exists (or whose pid, by its start time, now belongs to another process)
#   running   Claude Code's lock of an agent whose process is alive and which has not stopped
#   unknown   any other lock, or one this cannot read: never broken
classify_lock() {
  local reason agent="" pid="" start="" ledger_file="$project/.factory/ledger.jsonl" cur
  lock_state=none lock_reason=""
  reason=$(worktree_lock_reason "$1") || return 0
  lock_reason=$reason lock_state=unknown
  [[ "$reason" =~ ^claude\ agent\ (agent-)?([^\ ]+) ]] || return 0
  agent=${BASH_REMATCH[2]}
  if [ -f "$ledger_file" ] && jq -s -e --arg a "$agent" 'any(.[]; type == "object" and .event == "agent_stop"
      and (.agent_id == $a or .agent_id == "agent-\($a)"))' "$ledger_file" >/dev/null 2>&1; then
    lock_state=finished
    return 0
  fi
  [[ "$reason" =~ pid\ ([0-9]+) ]] || return 0
  pid=${BASH_REMATCH[1]}
  [[ "$reason" =~ start\ ([0-9]+) ]] && start=${BASH_REMATCH[1]}
  if ! pid_alive "$pid"; then
    lock_state=gone
  elif [ -n "$start" ] && [ -r "/proc/$pid/stat" ]; then
    cur=$(sed 's/^.*) //' "/proc/$pid/stat" | cut -d' ' -f20)
    if [ "$cur" = "$start" ]; then lock_state=running; else lock_state=gone; fi
  else
    lock_state=running
  fi
  return 0
}

# cleanup_ticket BRANCH WORKTREE INTEGRATION_WORKTREE: removes a merged ticket's worktree and
# deletes its branch locally and on origin, unless its agent may still be using them. Sets
# removed (true|false|null: no worktree there), deleted (true|false), remote_deleted (true|false|
# null: not on origin), lock_state, lock_reason and note. Reports what happened, never what was hoped.
cleanup_ticket() {
  local tb=$1 twt=$2 iwt=$3 local_gone=false
  removed=null deleted=false remote_deleted=null note="" lock_state=none lock_reason=""
  if [ -n "$twt" ] && [ -e "$twt" ]; then
    classify_lock "$twt"
    case "$lock_state" in
      running) removed=false note="the agent is still running (lock: $lock_reason); worktree and branch left in place" ;;
      unknown) removed=false note="the worktree is locked by something that is not a finished or gone Claude Code agent (lock: $lock_reason); worktree and branch left in place" ;;
      *)
        if [ -n "$(git -C "$twt" status --porcelain 2>/dev/null)" ]; then
          # not clean apart from ignored build output: someone's work may be in it
          removed=false note="the worktree has uncommitted changes; worktree and branch left in place"
        else
          [ "$lock_state" = none ] || g worktree unlock "$twt" 2>/dev/null || true
          if g worktree remove --force "$twt" 2>/dev/null; then
            removed=true
          else
            removed=false note="git could not remove the worktree; worktree and branch left in place"
          fi
        fi ;;
    esac
  fi
  if [ "$removed" != false ]; then
    if g rev-parse -q --verify "refs/heads/$tb" >/dev/null; then
      if ! { [ -d "$iwt" ] && git -C "$iwt" branch -q -d "$tb" 2>/dev/null; }; then
        note="${note:+$note; }the local branch $tb was not deleted"
      fi
    fi
    if g ls-remote --exit-code --heads origin "$tb" >/dev/null 2>&1; then
      # --no-verify: nothing is pushed, and the project's pre-push check would only run for minutes
      if g push -q --no-verify origin --delete "$tb" >/dev/null 2>&1; then
        remote_deleted=true
      else
        remote_deleted=false note="${note:+$note; }the branch $tb was not deleted on origin"
      fi
    fi
    g rev-parse -q --verify "refs/heads/$tb" >/dev/null || local_gone=true
    if [ "$local_gone" = true ] && [ "$remote_deleted" != false ]; then deleted=true; fi
  fi
  return 0
}

# leftovers_json [TICKET]: the merged tickets whose worktree or branch is still there.
leftovers_json() {
  local only=${1:-} out="[]" row t sp tb twt we bl br assigned
  assigned=$("$state_cmd" show | jq -c '.assignments | keys')
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    t=$(jq -r .ticket <<<"$row") sp=$(jq -r .spec <<<"$row")
    # a ticket sent back for rework is in use again: its branch and worktree are not leftovers
    jq -e --arg t "$t" 'index($t) | not' <<<"$assigned" >/dev/null || continue
    tb=$(jq -r '.branch // ""' <<<"$row") twt=$(jq -r '.worktree // ""' <<<"$row")
    [ -z "$only" ] || [ "$only" = "$t" ] || continue
    we=false bl=false br=false lock_state=none lock_reason=""
    if [ -n "$twt" ] && [ -e "$twt" ]; then we=true; classify_lock "$twt"; fi
    if [ -n "$tb" ]; then
      if g rev-parse -q --verify "refs/heads/$tb" >/dev/null; then bl=true; fi
      if g ls-remote --exit-code --heads origin "$tb" >/dev/null 2>&1; then br=true; fi
    fi
    [ "$we$bl$br" != falsefalsefalse ] || continue
    out=$(jq -c --argjson t "$t" --argjson sp "$sp" --arg tb "$tb" --arg twt "$twt" --argjson we "$we" --argjson bl "$bl" \
      --argjson br "$br" --arg ls "$lock_state" --arg lr "$lock_reason" \
      '. + [{ticket: $t, spec: $sp, branch: $tb, worktree: (if $twt == "" then null else $twt end), worktree_exists: $we,
             branch_local: $bl, branch_remote: $br, lock: $ls, lock_reason: (if $lr == "" then null else $lr end)}]' <<<"$out")
  done < <("$state_cmd" show | jq -c '.merged | to_entries | sort_by(.value.ticket)[] | .value')
  printf '%s\n' "$out"
}

# --- the per-branch merge queue ---
# .factory/locks/<branch>/ holds one file per merge that wants the branch, named q<sequence>.
# A sequence number is taken with `ln`, which fails when the name exists, so numbers are unique
# and follow the order merges started. The merge with the lowest live entry holds the lock; the
# others wait their turn. An entry records the holder's PID, ticket and start time; an entry whose
# PID no longer exists is stale and the first merge to see it removes it.
lock_entry="" waited="" queued=""
lock_release() {
  if [ -n "$lock_entry" ]; then rm -f "$lock_entry"; lock_entry=""; fi
}
lock_acquire() { # lock_acquire <integration branch> <ticket>
  local slug dir n tmpf lowest f pid t since began poll=${FACTORY_LOCK_POLL:-0.2}
  slug=$(printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_')
  dir="$project/.factory/locks/$slug"
  mkdir -p "$dir"
  factory_exclude "$project" /.factory/
  tmpf=$(mktemp "$dir/tmp.XXXXXX")
  printf 'pid=%s\nticket=%s\nstarted=%s\n' "$$" "$2" "$(factory_now)" >"$tmpf"
  trap lock_release EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  while :; do
    n=$(find "$dir" -maxdepth 1 -type f -name 'q*' | sed 's|.*/q||' | sort | tail -n 1)
    n=$(printf 'q%08d' $((10#${n:-0} + 1)))
    if ln "$tmpf" "$dir/$n" 2>/dev/null; then lock_entry="$dir/$n"; break; fi
  done
  rm -f "$tmpf"
  began=$(date +%s)
  while :; do
    lowest=""
    for f in "$dir"/q*; do
      [ -e "$f" ] || continue
      pid=$(sed -n 's/^pid=//p' "$f" 2>/dev/null || true)
      if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
        t=$(sed -n 's/^ticket=//p' "$f"); since=$(sed -n 's/^started=//p' "$f")
        if rm "$f" 2>/dev/null; then
          echo "factory-integration: taking over the stale lock on $1: its holder PID $pid (ticket #$t, started $since) no longer exists" >&2
        fi
        continue
      fi
      lowest=$f
      break
    done
    [ "$lowest" = "$lock_entry" ] && break
    queued=true
    sleep "$poll"
  done
  if [ -n "$queued" ]; then waited=$(( $(date +%s) - began )); fi
}
# merge_times: --duration-s (the merge's wall time, queueing included) and --waited-s (when it queued),
# the arguments factory-state records on the merge event.
merge_began=""
merge_times() {
  printf '%s\n' --duration-s "$(( $(date +%s) - merge_began ))"
  if [ -n "$waited" ]; then printf '%s\n' --waited-s "$waited"; fi
}
# record_merge_failure <result>: the merge event of a merge that did not merge (a failed merge is
# still merge time).
record_merge_failure() {
  local times
  mapfile -t times < <(merge_times)
  "$state_cmd" merge --ticket "$ticket" --result "$1" "${times[@]}"
}
# result: reads the result JSON on stdin; adds waited_seconds when this merge waited its turn.
result() {
  jq --argjson w "${waited:-null}" 'if $w == null then . else . + {waited_seconds: $w} end'
}

case "$cmd" in
ensure)
  [[ "$spec" =~ ^[0-9]+$ ]] || die "ensure needs --spec <number>"
  [[ "$branch" == spec/* ]] || die "an integration branch is named spec/<number>-<slug>, got '$branch'"
  def=$(default_branch)
  [ "$branch" != "$def" ] || die "refusing to use the default branch as an integration branch"
  g fetch -q origin
  created=false
  if ! g rev-parse -q --verify "refs/remotes/origin/$branch" >/dev/null; then
    if g rev-parse -q --verify "refs/heads/$branch" >/dev/null; then
      src="refs/heads/$branch"
    else
      src="refs/remotes/origin/$def"
      g rev-parse -q --verify "$src" >/dev/null || die "origin has no default branch $def"
    fi
    g push -q origin "$src:refs/heads/$branch" >&2 || die "could not push $branch to origin"
    g fetch -q origin
    created=true
  fi
  wt="$project/.claude/worktrees/spec-$spec"
  if [ ! -d "$wt" ]; then
    factory_exclude "$project" /.claude/worktrees/ /.factory/
    mkdir -p "$project/.claude/worktrees"
    if g rev-parse -q --verify "refs/heads/$branch" >/dev/null; then
      g worktree add -q "$wt" "$branch" >&2 || die "could not add the worktree $wt for $branch (is $branch checked out elsewhere?)"
    else
      g worktree add -q --track -b "$branch" "$wt" "origin/$branch" >&2 || die "could not add the worktree $wt"
    fi
  fi
  "$state_cmd" integration --spec "$spec" --branch "$branch" --worktree "$wt"
  jq -n --argjson spec "$spec" --arg branch "$branch" --arg wt "$wt" --argjson created "$created" \
    '{spec: $spec, branch: $branch, worktree: $wt, created: $created}'
  ;;
merge)
  [[ "$ticket" =~ ^[0-9]+$ ]] || die "merge needs --ticket <number>"
  [ -n "$branch" ] || die "merge needs --branch <ticket branch>"
  st=$("$state_cmd" show)
  spec=$(jq -r --arg t "$ticket" '.assignments[$t].spec // empty' <<<"$st")
  [ -n "$spec" ] || die "ticket #$ticket has no assignment in the factory state"
  ib=$(jq -r --arg s "$spec" '.integration[$s].branch // empty' <<<"$st")
  wt=$(jq -r --arg s "$spec" '.integration[$s].worktree // empty' <<<"$st")
  [ -n "$ib" ] && [ -d "$wt" ] || die "spec #$spec has no integration worktree; run factory-integration ensure first"
  def=$(default_branch)
  [ "$ib" != "$def" ] || die "refusing to merge into the default branch"
  merge_began=$(date +%s)
  lock_acquire "$ib" "$ticket"
  w() { git -C "$wt" "$@"; }
  [ "$(w symbolic-ref -q --short HEAD)" = "$ib" ] || die "$wt is not on $ib"
  [ -z "$(w status --porcelain --untracked-files=no)" ] || die "$wt has uncommitted changes"
  g rev-parse -q --verify "refs/heads/$branch" >/dev/null || die "no local branch $branch"
  w fetch -q origin
  if ! w merge -q --ff-only "origin/$ib" >/dev/null 2>&1; then
    record_merge_failure diverged
    jq -n --arg b "$ib" '{result: "diverged", detail: "the local \($b) has commits origin does not, and origin has commits it does not; nothing merged"}' | result
    exit 4
  fi
  before=$(w rev-parse HEAD)
  msg="Merge $branch into $ib${title:+: $title} (#$ticket)"
  if ! w merge -q --no-ff --no-edit -m "$msg" "$branch" >/dev/null 2>&1; then
    files=$(w diff --name-only --diff-filter=U | jq -R -s -c 'split("\n") | map(select(length > 0))')
    w merge --abort >/dev/null 2>&1 || w reset -q --hard "$before"
    record_merge_failure conflict
    jq -n --arg tb "$branch" --arg ib "$ib" --argjson files "$files" \
      '{result: "conflict", ticket_branch: $tb, integration_branch: $ib, files: $files}' | result
    exit 3
  fi
  commit=$(w rev-parse HEAD)
  if ! out=$(w push origin "$ib" 2>&1); then
    w reset -q --hard "$before"
    record_merge_failure push-failed
    jq -n --arg ib "$ib" --arg out "$out" '{result: "push-failed", integration_branch: $ib, output: $out}' | result
    exit 4
  fi
  [ -n "$worktree" ] || worktree=$(jq -r --arg t "$ticket" '.assignments[$t].worktree // empty' <<<"$st")
  cleanup_ticket "$branch" "$worktree" "$wt"
  mapfile -t times < <(merge_times)
  "$state_cmd" merge --ticket "$ticket" --commit "$commit" ${worktree:+--worktree "$worktree"} "${times[@]}"
  errf=$(mktemp "${TMPDIR:-/tmp}/factory-integration.XXXXXX")
  pr_err=""
  if ! pr=$(draft_pr "$spec" "$ib" "$def" "$ticket" "$title" 2>"$errf"); then
    pr=null pr_err=$(cat "$errf")
    pr_err=${pr_err:-gh failed}
  fi
  rm -f "$errf"
  jq -n --arg c "$commit" --arg tb "$branch" --arg ib "$ib" --arg wt "$worktree" \
    --argjson removed "$removed" --argjson deleted "$deleted" --argjson rdeleted "$remote_deleted" \
    --arg ls "$lock_state" --arg lr "$lock_reason" --arg note "$note" --argjson pr "$pr" --arg pr_err "$pr_err" \
    '{result: "merged", commit: $c, ticket_branch: $tb, integration_branch: $ib,
      worktree: (if $wt == "" then null else $wt end), worktree_removed: $removed, branch_deleted: $deleted,
      remote_branch_deleted: $rdeleted,
      worktree_lock: {state: $ls, reason: (if $lr == "" then null else $lr end)},
      cleanup_note: (if $note == "" then null else $note end),
      pull_request: $pr} + (if $pr_err == "" then {} else {pull_request_error: $pr_err} end)' | result
  ;;
leftovers)
  rows=$(leftovers_json "$ticket")
  if [ "$json" = 1 ]; then
    jq . <<<"$rows"
  elif [ "$(jq length <<<"$rows")" = 0 ]; then
    echo "No leftover worktrees or branches."
  else
    jq -r '(["ticket", "spec", "branch", "worktree", "local", "origin", "lock"] | @tsv),
      (.[] | ["#\(.ticket)", "#\(.spec)", .branch, (if .worktree_exists then .worktree else "-" end),
              (if .branch_local then "yes" else "-" end), (if .branch_remote then "yes" else "-" end),
              (if .lock == "none" then "-" else .lock end)] | @tsv)' <<<"$rows" | column -t -s "$(printf '\t')"
  fi
  ;;
cleanup)
  res="[]"
  for t in $(leftovers_json "$ticket" | jq -r '.[].ticket'); do
    row=$("$state_cmd" show | jq -c --arg t "$t" '.merged[$t]')
    sp=$(jq -r .spec <<<"$row") tb=$(jq -r '.branch // ""' <<<"$row") twt=$(jq -r '.worktree // ""' <<<"$row")
    iwt=$("$state_cmd" show | jq -r --arg s "$sp" '.integration[$s].worktree // empty')
    cleanup_ticket "$tb" "$twt" "$iwt"
    res=$(jq -c --argjson t "$t" --argjson sp "$sp" --arg tb "$tb" --arg twt "$twt" --argjson removed "$removed" \
      --argjson deleted "$deleted" --argjson rdeleted "$remote_deleted" --arg ls "$lock_state" --arg lr "$lock_reason" --arg note "$note" \
      '. + [{ticket: $t, spec: $sp, branch: $tb, worktree: (if $twt == "" then null else $twt end),
             worktree_removed: $removed, branch_deleted: $deleted, remote_branch_deleted: $rdeleted,
             worktree_lock: {state: $ls, reason: (if $lr == "" then null else $lr end)},
             cleanup_note: (if $note == "" then null else $note end)}]' <<<"$res")
  done
  jq . <<<"$res"
  ;;
esac
