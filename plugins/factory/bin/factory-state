#!/usr/bin/env bash
# shellcheck disable=SC2016 # jq programs are single-quoted on purpose
# factory-state: reads and updates <project>/.factory/state.json and appends the matching
# factory events to the ledger. Every update is atomic (written to a temporary file in the
# same directory, then renamed) and serialized by a lock directory.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: factory-state <command> [options]

  show                         print the state JSON (an empty state when none is saved)
  list [--json]                running assignments with their age; a ticket whose gate passed but
                               that has not merged for longer than merge_stall_minutes (settings,
                               default 60) shows as merge-stalled with the time since the pass
  assign --ticket N --spec S --role R --model M --effort E --branch B [--worktree P] [--agent ID]
                               record an assignment; ledger: assign {ticket, spec, role, model, effort, branch}.
                               Exit 3 when the ticket already has one: an assigned ticket is never given
                               to a second agent (a restarted session uses resume)
  update --ticket N [--agent ID] [--worktree P] [--branch B]
                               fill in what is known after the agent starts
  resume --ticket N --action resume|restart
                               a restarted session takes an assignment over (see factory-resume): keeps
                               it (role, model, effort, branch, started, gate failures, escalation),
                               clears its agent and worktree (the caller removes the old worktree and
                               starts the new agent, then runs update), stamps resumed_at;
                               ledger: resume {ticket, spec, action, role, model, effort}
  unassign --ticket N [--reason TEXT]
                               drop an assignment without merging; ledger: unassign {ticket, spec, reason}
  merge --ticket N --commit SHA [--worktree P] [--duration-s S] [--waited-s S]
                               the ticket is merged into its integration branch: moves the assignment
                               to merged, keeping its worktree path (P, else the assignment's) so a
                               clean-up left undone can be retried; ledger: merge {ticket, spec, branch,
                               commit, result: merged, duration_s, waited_s}
  merge --ticket N --result conflict|diverged|push-failed [--duration-s S] [--waited-s S]
                               a merge that did not merge: ledger only (merge {..., result, duration_s,
                               waited_s}); the assignment stays
  rework --ticket N --reason TEXT [--role R --model M --effort E --branch B]
                               a merged ticket goes back for a follow-up fix: assigns it again (role,
                               model and effort default to its earlier assignment, branch to the
                               merged one), keeping its merge; the next merge adds its commit to the
                               record and keeps the old one. ledger: gate {result: fail, reason} then
                               rework {ticket, spec, reason, role, model, effort, branch}
  gate --ticket N --result pass|fail [--tests-added K]
                               ledger: gate {ticket, spec, result, tests_added}; counts the assignment's
                               failures and prints {ticket, result, failures, next}: next is merge (pass),
                               retry (first failure), escalate (second failure, never escalated, a tier
                               above exists) or stop (otherwise: unassign and tell the user)
  stall --ticket N             ledger: stall {ticket, spec}; prints {ticket, next}: escalate or stop
  escalate --ticket N --reason TEXT
                               re-run the ticket once one tier up (factory-roles next): the assignment
                               takes the new role, model and effort; state: escalations[N]; ledger:
                               escalation {ticket, spec, from, to, from_model, from_effort, model, effort,
                               reason}. Prints {ticket, spec, branch, reason, role, agent, model, effort,
                               effort_override, previous: {role, model, effort, agent, worktree}}.
                               Exit 3, changing nothing, when the ticket has no assignment, was already
                               escalated, or has no tier above.
  review --spec S --findings K [--role R]
                               ledger only: review {spec, role, findings}; the spec report counts them
  ci --ticket N --result green|failed|red-on-default|infra|timeout|none --duration-s S [--commit SHA] [--reason TEXT]
                               ledger only: ci {ticket, spec, commit, result, duration_s, reason}; the CI
                               on a merged commit: green and failed feed the CI pass rate and duration KPIs
  integration --spec S --branch B [--worktree P] [--status active|complete]
                               record a spec's integration branch
  estimate --spec S --usd X    record a spec's cost estimate (the first one is kept as first)
  running on|off               whether the manager is running (start / stop)

State: <project>/.factory/state.json (project: $CLAUDE_PROJECT_DIR, else the repository's main
checkout). Ledger: <project>/.factory/ledger.jsonl. FACTORY_NOW overrides the time (tests).
USAGE
}

root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
# shellcheck disable=SC1091 # lib/common.sh, checked on its own
. "$root/lib/common.sh"

project=$(factory_project)
dir="$project/.factory"
state="$dir/state.json"
ledger="$dir/ledger.jsonl"
lock="$dir/state.lock"
empty='{"version": 1, "running": false, "assignments": {}, "merged": {}, "integration": {}, "estimates": {}, "escalations": {}}'

die() { echo "factory-state: $*" >&2; exit 2; }
refuse() { echo "factory-state: $*" >&2; exit 3; }
current() {
  if [ -f "$state" ]; then
    jq -c --argjson e "$empty" '$e * .' "$state" || die "$state is not valid JSON; fix or remove it"
  else
    echo "$empty"
  fi
}

release() { rmdir "$lock" 2>/dev/null || true; }
acquire() {
  [ -d "$dir" ] || { mkdir -p "$dir"; factory_exclude "$project" /.factory/; }
  local i
  for i in $(seq 1 100); do
    if mkdir "$lock" 2>/dev/null; then
      trap release EXIT
      return
    fi
    # a lock older than a minute was left by a killed process
    if [ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then rmdir "$lock" 2>/dev/null || true; fi
    sleep 0.1
    : "$i"
  done
  die "could not lock $lock"
}

# mutate <jq filter> [jq args...]: applies the filter to the state and saves it atomically.
mutate() {
  local filter=$1; shift
  acquire
  local new tmp
  new=$(current | jq --arg now "$(factory_now)" "$@" "$filter")
  tmp=$(mktemp "$dir/.state.XXXXXX")
  printf '%s\n' "$new" >"$tmp"
  mv -f "$tmp" "$state"
  release
  trap - EXIT
}

# event <jq object expression> [jq args...]: appends one ledger line.
event() {
  local expr=$1; shift
  [ -d "$dir" ] || { mkdir -p "$dir"; factory_exclude "$project" /.factory/; }
  jq -nc --arg ts "$(factory_now)" --arg sid "${CLAUDE_SESSION_ID:-}" "$@" \
    '{ts: $ts} + ('"$expr"') + {session_id: (if $sid == "" then null else $sid end)}' >>"$ledger"
}

# can_escalate <ticket>: it has an assignment, was never escalated, and its role has a tier above
can_escalate() {
  local a
  a=$(current | jq -c --arg t "$1" 'if .escalations | has($t) then empty else .assignments[$t] // empty end')
  [ -n "$a" ] || return 1
  "$root/bin/factory-roles" next "$(jq -r .role <<<"$a")" --effort "$(jq -r .effort <<<"$a")" --project "$project" >/dev/null 2>&1
}

num_re='^[0-9]+$'
need_num() { [[ "${2:-}" =~ $num_re ]] || die "$1 needs a number, got '${2:-}'"; }

cmd=${1:-}
[ -n "$cmd" ] || { usage >&2; exit 2; }
case "$cmd" in -h | --help) usage; exit 0 ;; esac
shift
ticket="" spec="" role="" model="" effort="" branch="" worktree="" agent="" commit="" result=""
tests_added="" reason="" status="" usd="" duration="" waited="" findings="" action="" json=0
while [ $# -gt 0 ]; do
  case "$1" in
    --ticket) ticket=${2:?}; shift ;;
    --spec) spec=${2:?}; shift ;;
    --role) role=${2:?}; shift ;;
    --model) model=${2:?}; shift ;;
    --effort) effort=${2:?}; shift ;;
    --branch) branch=${2:?}; shift ;;
    --worktree) worktree=${2:?}; shift ;;
    --agent) agent=${2:?}; shift ;;
    --commit) commit=${2:?}; shift ;;
    --result) result=${2:?}; shift ;;
    --tests-added) tests_added=${2:?}; shift ;;
    --duration-s) duration=${2:?}; shift ;;
    --waited-s) waited=${2:?}; shift ;;
    --reason) reason=${2:?}; shift ;;
    --status) status=${2:?}; shift ;;
    --usd) usd=${2:?}; shift ;;
    --findings) findings=${2:?}; shift ;;
    --action) action=${2:?}; shift ;;
    --json) json=1 ;;
    on | off) [ "$cmd" = running ] || die "unexpected argument $1"; status=$1 ;;
    -h | --help) usage; exit 0 ;;
    *) die "unknown argument $1" ;;
  esac
  shift
done

case "$cmd" in
show)
  current | jq .
  ;;
list)
  now=$(factory_now)
  events='[]'
  [ ! -f "$ledger" ] || events=$(jq -R -s -c 'split("\n") | map(fromjson? // empty) | map(select(type == "object"))' "$ledger")
  rows=$(current | jq -c --arg now "$now" --argjson ev "$events" \
    --argjson minutes "$(factory_merge_stall_minutes "$project")" -L "$root/lib" '
    include "stalled";
    merge_stalled($ev; null; $now; $minutes) as $stalled
    | [.assignments[] | . as $a
      | ([$stalled[] | select(.ticket == $a.ticket)] | first) as $m
      | . + {age_min: (if .started == null then null
          else ((($now | fromdateiso8601) - (.started | fromdateiso8601)) / 60 | floor) end),
        status: (if $m == null then "running" else "merge-stalled" end),
        stalled_min: ($m.age_min // null)}]
    | sort_by(.started)')
  if [ "$json" = 1 ]; then
    jq . <<<"$rows"
  elif [ "$(jq length <<<"$rows")" = 0 ]; then
    echo "No running assignments."
  else
    jq -r 'def dur: if . < 60 then "\(.)m" else "\(. / 60 | floor)h\(. % 60)m" end;
      (["ticket", "spec", "role", "model", "effort", "age", "status", "branch"] | @tsv),
      (.[] | ["#\(.ticket)", "#\(.spec)", .role, .model, .effort,
              (if .age_min == null then "?" else .age_min | dur end),
              (if .status == "merge-stalled" then "merge-stalled \(.stalled_min | dur)" else .status end),
              (.branch // "")] | @tsv)' <<<"$rows" | column -t -s "$(printf '\t')"
  fi
  ;;
assign)
  need_num --ticket "$ticket"; need_num --spec "$spec"
  [ -n "$role" ] && [ -n "$model" ] && [ -n "$effort" ] && [ -n "$branch" ] || die "assign needs --role, --model, --effort and --branch"
  if current | jq -e --arg t "$ticket" '.assignments | has($t)' >/dev/null; then
    refuse "ticket #$ticket is already assigned (agent $(current | jq -r --arg t "$ticket" '.assignments[$t].agent // "none"')); an agent runs it, or factory-resume takes it over after a restart"
  fi
  mutate '.assignments[$t] = {ticket: ($t | tonumber), spec: ($s | tonumber), role: $role, model: $model,
      effort: $effort, branch: $branch, worktree: (if $wt == "" then null else $wt end),
      agent: (if $agent == "" then null else $agent end), started: $now}' \
    --arg t "$ticket" --arg s "$spec" --arg role "$role" --arg model "$model" --arg effort "$effort" \
    --arg branch "$branch" --arg wt "$worktree" --arg agent "$agent"
  event '{event: "assign", ticket: ($t | tonumber), spec: ($s | tonumber), role: $role, model: $model, effort: $effort, branch: $branch}' \
    --arg t "$ticket" --arg s "$spec" --arg role "$role" --arg model "$model" --arg effort "$effort" --arg branch "$branch"
  ;;
update)
  need_num --ticket "$ticket"
  current | jq -e --arg t "$ticket" '.assignments | has($t)' >/dev/null || die "ticket #$ticket has no assignment"
  mutate '.assignments[$t] |= (. + ({agent: $agent, worktree: $wt, branch: $branch} | with_entries(select(.value != ""))))' \
    --arg t "$ticket" --arg agent "$agent" --arg wt "$worktree" --arg branch "$branch"
  ;;
resume)
  need_num --ticket "$ticket"
  case "$action" in resume | restart) ;; *) die "resume needs --action resume or restart" ;; esac
  a=$(current | jq -c --arg t "$ticket" '.assignments[$t] // empty')
  [ -n "$a" ] || die "ticket #$ticket has no assignment"
  mutate '.assignments[$t] |= (. + {agent: null, worktree: null, resumed_at: $now})' --arg t "$ticket"
  event '{event: "resume", ticket: $a.ticket, spec: $a.spec, action: $act, role: $a.role, model: $a.model, effort: $a.effort}' \
    --argjson a "$a" --arg act "$action"
  ;;
unassign)
  need_num --ticket "$ticket"
  spec=$(current | jq -r --arg t "$ticket" '.assignments[$t].spec // empty')
  [ -n "$spec" ] || die "ticket #$ticket has no assignment"
  mutate 'del(.assignments[$t])' --arg t "$ticket"
  event '{event: "unassign", ticket: ($t | tonumber), spec: ($s | tonumber), reason: (if $r == "" then null else $r end)}' \
    --arg t "$ticket" --arg s "$spec" --arg r "$reason"
  ;;
merge)
  need_num --ticket "$ticket"
  [ -z "$duration" ] || need_num --duration-s "$duration"
  [ -z "$waited" ] || need_num --waited-s "$waited"
  case "${result:-merged}" in merged | conflict | diverged | push-failed) ;; *) die "--result is merged, conflict, diverged or push-failed" ;; esac
  a=$(current | jq -c --arg t "$ticket" '.assignments[$t] // empty')
  [ -n "$a" ] || die "ticket #$ticket has no assignment"
  if [ "${result:-merged}" != merged ]; then
    # the merge did not happen: the record is the ledger event only
    event '{event: "merge", ticket: $a.ticket, spec: $a.spec, branch: $a.branch, commit: null, result: $r,
        duration_s: (if $d == "" then null else ($d | tonumber) end), waited_s: (if $w == "" then null else ($w | tonumber) end)}' \
      --argjson a "$a" --arg r "$result" --arg d "$duration" --arg w "$waited"
    exit 0
  fi
  [ -n "$commit" ] || die "merge needs --commit"
  # a ticket merged again after a rework keeps its earlier commits: commits lists them all
  mutate '(.merged[$t] // null) as $prev
      | .merged[$t] = {ticket: $a.ticket, spec: $a.spec, branch: $a.branch}
        + (if ($wt != "" or $a.worktree != null) then {worktree: (if $wt != "" then $wt else $a.worktree end)} else {} end)
        + {commit: $c, merged_at: $now}
        + (if $prev == null then {} else {commits: (($prev.commits // [$prev.commit]) + [$c])} end)
      | del(.assignments[$t])' --arg t "$ticket" --argjson a "$a" --arg c "$commit" --arg wt "$worktree"
  event '{event: "merge", ticket: $a.ticket, spec: $a.spec, branch: $a.branch, commit: $c, result: "merged",
      duration_s: (if $d == "" then null else ($d | tonumber) end), waited_s: (if $w == "" then null else ($w | tonumber) end)}' \
    --argjson a "$a" --arg c "$commit" --arg d "$duration" --arg w "$waited"
  ;;
rework)
  need_num --ticket "$ticket"
  [ -n "$reason" ] || die "rework needs --reason"
  m=$(current | jq -c --arg t "$ticket" '.merged[$t] // empty')
  [ -n "$m" ] || die "ticket #$ticket is not merged; only a merged ticket can be reworked"
  current | jq -e --arg t "$ticket" '.assignments | has($t) | not' >/dev/null || die "ticket #$ticket already has an assignment"
  # what the ticket was first assigned with, unless given
  prev="{}"
  if [ -f "$ledger" ]; then
    prev=$(jq -s -c --argjson t "$ticket" '[.[] | select(type == "object" and .event == "assign" and .ticket == $t)] | last // {}' "$ledger")
  fi
  spec=$(jq -r .spec <<<"$m")
  [ -n "$role" ] || role=$(jq -r '.role // "implementer"' <<<"$prev")
  [ -n "$model" ] || model=$(jq -r '.model // "sonnet"' <<<"$prev")
  [ -n "$effort" ] || effort=$(jq -r '.effort // "high"' <<<"$prev")
  [ -n "$branch" ] || branch=$(jq -r '.branch' <<<"$m")
  mutate '.assignments[$t] = {ticket: ($t | tonumber), spec: ($s | tonumber), role: $role, model: $model,
      effort: $effort, branch: $branch, worktree: null, agent: null, started: $now}' \
    --arg t "$ticket" --arg s "$spec" --arg role "$role" --arg model "$model" --arg effort "$effort" --arg branch "$branch"
  event '{event: "gate", ticket: ($t | tonumber), spec: ($s | tonumber), result: "fail", tests_added: null, reason: $r}' \
    --arg t "$ticket" --arg s "$spec" --arg r "$reason"
  event '{event: "rework", ticket: ($t | tonumber), spec: ($s | tonumber), reason: $r, role: $role, model: $model, effort: $effort, branch: $branch}' \
    --arg t "$ticket" --arg s "$spec" --arg r "$reason" --arg role "$role" --arg model "$model" --arg effort "$effort" --arg branch "$branch"
  ;;
gate)
  need_num --ticket "$ticket"
  case "$result" in pass | fail) ;; *) die "gate needs --result pass or fail" ;; esac
  [ -z "$tests_added" ] || need_num --tests-added "$tests_added"
  spec=$(current | jq -r --arg t "$ticket" '(.assignments[$t] // .merged[$t] // {}).spec // empty')
  failures=null
  if current | jq -e --arg t "$ticket" '.assignments | has($t)' >/dev/null; then
    if [ "$result" = fail ]; then
      mutate '.assignments[$t].gate_failures = ((.assignments[$t].gate_failures // 0) + 1)' --arg t "$ticket"
    else
      mutate 'del(.assignments[$t].gate_failures)' --arg t "$ticket"
    fi
    failures=$(current | jq --arg t "$ticket" '.assignments[$t].gate_failures // 0')
  fi
  event '{event: "gate", ticket: ($t | tonumber), spec: (if $s == "" then null else ($s | tonumber) end), result: $r,
      tests_added: (if $k == "" then null else ($k | tonumber) end)}' \
    --arg t "$ticket" --arg s "$spec" --arg r "$result" --arg k "$tests_added"
  if [ "$result" = pass ]; then next=merge failures=0
  elif [ "$failures" = null ]; then next=stop
  elif [ "$failures" -lt 2 ]; then next=retry
  elif can_escalate "$ticket"; then next=escalate
  else next=stop; fi
  jq -nc --argjson t "$ticket" --arg r "$result" --argjson f "$failures" --arg n "$next" \
    '{ticket: $t, result: $r, failures: $f, next: $n}'
  ;;
stall)
  need_num --ticket "$ticket"
  spec=$(current | jq -r --arg t "$ticket" '(.assignments[$t] // {}).spec // empty')
  event '{event: "stall", ticket: ($t | tonumber), spec: (if $s == "" then null else ($s | tonumber) end)}' \
    --arg t "$ticket" --arg s "$spec"
  if can_escalate "$ticket"; then next=escalate; else next=stop; fi
  jq -nc --argjson t "$ticket" --arg n "$next" '{ticket: $t, next: $n}'
  ;;
escalate)
  need_num --ticket "$ticket"
  [ -n "$reason" ] || die "escalate needs --reason"
  a=$(current | jq -c --arg t "$ticket" '.assignments[$t] // empty')
  [ -n "$a" ] || refuse "ticket #$ticket has no assignment"
  e=$(current | jq -c --arg t "$ticket" '.escalations[$t] // empty')
  [ -z "$e" ] || refuse "ticket #$ticket was already escalated once ($(jq -r '"\(.from.role) \(.from.model)/\(.from.effort) to \(.to.role) \(.to.model)/\(.to.effort)"' <<<"$e")); stop and tell the user"
  to=$("$root/bin/factory-roles" next "$(jq -r .role <<<"$a")" --effort "$(jq -r .effort <<<"$a")" --project "$project" 2>/dev/null) ||
    refuse "no tier above $(jq -r '"\(.role) \(.model)/\(.effort)"' <<<"$a") for ticket #$ticket; stop and tell the user"
  # the previous attempt's worktree: as recorded, else the worktree that has the ticket's branch
  wt=$(jq -r '.worktree // empty' <<<"$a")
  if [ -z "$wt" ]; then
    wt=$(git -C "$project" worktree list --porcelain 2>/dev/null | awk -v b="branch refs/heads/$(jq -r .branch <<<"$a")" \
      '/^worktree / { w = substr($0, 10) } $0 == b { print w; exit }' || true)
  fi
  mutate '.escalations[$t] = {ticket: $a.ticket, spec: $a.spec, from: ($a | {role, model, effort}),
      to: ($to | {role, model, effort}), reason: $r, at: $now}
    | .assignments[$t] = ($a + ($to | {role, model, effort}) + {agent: null, worktree: null, started: $now} | del(.gate_failures))' \
    --arg t "$ticket" --argjson a "$a" --argjson to "$to" --arg r "$reason"
  event '{event: "escalation", ticket: $a.ticket, spec: $a.spec, from: $a.role, to: $to.role,
      from_model: $a.model, from_effort: $a.effort, model: $to.model, effort: $to.effort, reason: $r}' \
    --argjson a "$a" --argjson to "$to" --arg r "$reason"
  jq -nc --argjson a "$a" --argjson to "$to" --arg r "$reason" --arg wt "$wt" \
    '{ticket: $a.ticket, spec: $a.spec, branch: $a.branch, reason: $r} + $to
     + {previous: (($a | {role, model, effort, agent}) + {worktree: (if $wt == "" then null else $wt end)})}'
  ;;
review)
  need_num --spec "$spec"; need_num --findings "$findings"
  event '{event: "review", ticket: null, spec: ($s | tonumber), role: (if $r == "" then null else $r end), findings: ($k | tonumber)}' \
    --arg s "$spec" --arg r "$role" --arg k "$findings"
  ;;
ci)
  need_num --ticket "$ticket"
  need_num --duration-s "$duration"
  case "$result" in green | failed | red-on-default | infra | timeout | none) ;; *) die "ci needs --result green, failed, red-on-default, infra, timeout or none" ;; esac
  spec=$(current | jq -r --arg t "$ticket" '(.assignments[$t] // .merged[$t] // {}).spec // empty')
  event '{event: "ci", ticket: ($t | tonumber), spec: (if $s == "" then null else ($s | tonumber) end),
      commit: (if $c == "" then null else $c end), result: $r, duration_s: ($d | tonumber), reason: (if $why == "" then null else $why end)}' \
    --arg t "$ticket" --arg s "$spec" --arg c "$commit" --arg r "$result" --arg d "$duration" --arg why "$reason"
  ;;
integration)
  need_num --spec "$spec"
  [ -n "$branch" ] || die "integration needs --branch"
  case "${status:-active}" in active | complete) ;; *) die "--status is active or complete" ;; esac
  mutate '.integration[$s] = ((.integration[$s] // {created: $now}) + {spec: ($s | tonumber), branch: $branch, status: $st}
      + (if $wt == "" then {} else {worktree: $wt} end))' \
    --arg s "$spec" --arg branch "$branch" --arg wt "$worktree" --arg st "${status:-active}"
  ;;
estimate)
  need_num --spec "$spec"
  [[ "$usd" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "estimate needs --usd <amount>"
  mutate '.estimates[$s] = {first: (.estimates[$s].first // ($u | tonumber)), current: ($u | tonumber), updated: $now}' \
    --arg s "$spec" --arg u "$usd"
  ;;
running)
  case "$status" in on) v=true ;; off) v=false ;; *) die "running needs on or off" ;; esac
  mutate '.running = $v' --argjson v "$v"
  ;;
*) die "unknown command $cmd (see --help)" ;;
esac
